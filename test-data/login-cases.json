[
  {
    "name": "valid user - success",
    "email": "$E2E_USER_EMAIL",
    "password": "$E2E_USER_PASSWORD",
    "expected": "success"
  },
  {
    "name": "valid email + wrong password",
    "email": "$E2E_USER_EMAIL",
    "password": "DefinitelyWrong!123",
