  },
  {
    "name": "unknown user",
    "email": "e2e-unknown-user@example.com",
    "password": "Whatever!123",
    "expected": "error",
    "errorCode": "wrong-credentials"
  },
  {
    "name": "invalid email format",
    "email": "not-an-email",
    "password": "Whatever!123",
    "expected": "error",
    "errorCode": "wrong-credentials"
  },
  {
    "name": "empty email",
    "email": " ",
    "password": "Whatever!123",
    "expected": "error",
    "errorCode": "invalid-email-username"
  }
